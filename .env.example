# ─────────────────────────────────────────────────────────────────────────────
# Arbitrade — example configuration
# Copy to .env and adjust values. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# Trading mode: paper | live
# SAFETY: Default is paper. Live mode requires ENABLE_LIVE_TRADING confirmation.
TRADING_MODE=paper

# SQLite database path
DATABASE_PATH=data/arbitrade.db

# Exchanges to use (comma-separated)
ENABLED_EXCHANGES=binance,kucoin,okx,bybit

# Trading pairs (comma-separated)
ENABLED_PAIRS=BTC/USDT,ETH/USDT

# Fee per side in basis points (10 bps = 0.10%)
FEE_BPS=10

# Expected slippage per side in basis points
SLIPPAGE_BPS=5

# Minimum net profit to consider an opportunity (in quote currency)
MIN_NET_PROFIT=1.0

# Maximum quantity per trade
MAX_TRADE_QUANTITY=0.01

# Market data refresh interval in seconds
MARKET_DATA_REFRESH_SECONDS=2.0

# Stale data threshold in milliseconds
STALE_DATA_THRESHOLD_MS=5000

# Whether to use real CCXT exchange connections (true requires API keys)
# Set to false for pure paper trading without network access
USE_CCXT=false

# ─── Risk limits ──────────────────────────────────────────────────────────────
MAX_POSITION_SIZE=10000.0
MAX_TRADE_SIZE=5000.0
MAX_EXPOSURE_PER_EXCHANGE=20000.0
MAX_EXPOSURE_PER_ASSET=15000.0
MAX_DAILY_LOSS=2000.0
MAX_DRAWDOWN=0.2
MAX_CONCURRENT_OPPORTUNITIES=4
MAX_ORDER_AGE_SECONDS=10
STALE_MARKET_DATA_MS=1500
COOLDOWN_SECONDS=10

# ─── Paper trading starting balances ─────────────────────────────────────────
PAPER_STARTING_USDT=100000.0
PAPER_STARTING_BTC=1.0
PAPER_STARTING_ETH=10.0
PAPER_LATENCY_MS=50

# ─── Dashboard ────────────────────────────────────────────────────────────────
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── Telegram notifications (optional) ───────────────────────────────────────
# Leave blank to disable Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MIN_INTERVAL_SECONDS=5

# ─── Exchange API keys (optional — only needed for live/private access) ───────
# Public market data works without keys.
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# KUCOIN_API_KEY=
# KUCOIN_API_SECRET=
# KUCOIN_API_PASSWORD=
# OKX_API_KEY=
# OKX_API_SECRET=
# OKX_API_PASSWORD=
# BYBIT_API_KEY=
# BYBIT_API_SECRET=
